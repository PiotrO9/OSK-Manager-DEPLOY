# Backend
PORT=3001
NODE_ENV=production
FRONTEND_URL=http://<HOMELAB_LAN_IP>:3000

# Frontend
NUXT_PUBLIC_API_BASE=http://<HOMELAB_LAN_IP>:3001
NUXT_PUBLIC_SITE_URL=http://<HOMELAB_LAN_IP>:3000

# Application image tags
API_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest

# Optional homelab PostgreSQL service
# Start with: docker compose --profile postgres up -d postgres
POSTGRES_DB=osk_manager
POSTGRES_USER=osk_manager
POSTGRES_PASSWORD=change-me-generate-a-strong-password
POSTGRES_PORT=5432

# Optional API DATABASE_URL if you intentionally test API against homelab PostgreSQL.
# Do not use this as production DATABASE_URL unless you intentionally migrate from Supabase PROD.
# DATABASE_URL=postgresql://osk_manager:change-me-generate-a-strong-password@postgres:5432/osk_manager
